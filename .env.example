# ───────────────────────────────────────────────────────────────────────────────
# Cairn — environment variables
#
# Copy to `.env.local` and fill in. See docs/SETUP.md for what each one does
# and how to obtain credentials.
# ───────────────────────────────────────────────────────────────────────────────

# Required (boot) ─────────────────────────────────────────────────────────────
# 64-char hex; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public-facing URL of this app. Used for redirects, OG canonical, sitemap, robots.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin gate — comma-separated emails that can reach /admin/*.
ADMIN_EMAILS=

# Email (Resend) ──────────────────────────────────────────────────────────────
# Required for magic-link sign-in. The FROM address must be a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Cairn <noreply@your-verified-domain.com>"

# Billing (Paystack) ──────────────────────────────────────────────────────────
# Use pk_test_/sk_test_ for development. Switch to live keys in production.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Uploads (Cloudinary) ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# AI (Google Gemini) ──────────────────────────────────────────────────────────
# Required for the assistant chat, plan-my-day, breakdown, diagnose, note-assist.
# Get a free key at: https://aistudio.google.com/app/apikey
# Without a key, AI surfaces show "AI is not configured" inline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web Push (VAPID) ────────────────────────────────────────────────────────────
# Generate once per environment and KEEP THESE STABLE.
# Rotating the public key invalidates every existing browser subscription.
#
#   node -e "const w=require('web-push');const k=w.generateVAPIDKeys();\
#   console.log('VAPID_PUBLIC_KEY='+k.publicKey);\
#   console.log('VAPID_PRIVATE_KEY='+k.privateKey);\
#   console.log('NEXT_PUBLIC_VAPID_PUBLIC_KEY='+k.publicKey);"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron (Vercel Cron / external scheduler) ─────────────────────────────────────
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# OAuth — Google ──────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URIs:
#   http://localhost:3000/oauth/google/callback
#   https://<your-domain>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub ──────────────────────────────────────────────────────────────
# github.com/settings/developers → OAuth Apps.
# Callback URL: <APP_URL>/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth — Apple ───────────────────────────────────────────────────────────────
# developer.apple.com → Certificates → Keys & Identifiers.
# Return URL: <APP_URL>/oauth/apple/callback
# APPLE_PRIVATE_KEY: paste the .p8 contents with newlines escaped as \n
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional: persistence (MongoDB) ─────────────────────────────────────────────
# Not yet wired into the app, but the URI is reserved for the eventual
# server-side persistence layer (push subscriptions, user profiles, audit log).
MONGODB_URI=
